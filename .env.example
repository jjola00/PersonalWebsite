# Environment variables
# Copy to .env for local development. In production, set these in the Vercel
# project (Settings -> Environment Variables, or `vercel env add`).

# EmailJS (contact form) -- public, exposed to the browser
NEXT_PUBLIC_SERVICE_ID=
NEXT_PUBLIC_TEMPLATE_ID=
NEXT_PUBLIC_PUBLIC_KEY=

# Spotify -- secret and refresh token are server-only.
# Get a refresh token with: node scripts/spotify-auth.mjs
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Last.fm -- public, exposed to the browser
NEXT_PUBLIC_LASTFM_API_KEY=

# TMDB -- server-only; either works, the read access token is preferred
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# GitHub stats images (optional)
NEXT_PUBLIC_GITHUB_STATS_URL=https://github-readme-stats.vercel.app
NEXT_PUBLIC_GITHUB_STREAK_STATS_URL=https://github-readme-streak-stats.herokuapp.com

NEXT_TELEMETRY_DISABLED=1
